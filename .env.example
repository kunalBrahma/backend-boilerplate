# Docker Compose host-port overrides.
#
# Only needed if you're reusing this boilerplate for multiple projects and
# running more than one of them (or a local Postgres) at the same time —
# every copy defaults to the same host ports, which collide. To fix, copy
# this file to `.env` in the repo root and pick free ports for this project.
#
# This is separate from backend/.env (the app's own runtime config).
POSTGRES_PORT=5432
BACKEND_PORT=3000
